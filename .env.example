DATABRICKS_HOST=https://...
PGDATABASE=your_postgres_databaseName
LAKEBASE_ENDPOINT=your_postgres_endpointPath
PGHOST=your_postgres_host
PGPORT=5432
PGSSLMODE=require
# Needed by `npm run migrate` (node-pg-migrate via @databricks/lakebase):
# your Databricks email for local dev, or the service principal app id for M2M.
PGUSER=your_databricks_email_or_sp_client_id
DATABRICKS_APP_PORT=8000
DATABRICKS_APP_NAME=appkit-lakebase
FLASK_RUN_HOST=0.0.0.0
